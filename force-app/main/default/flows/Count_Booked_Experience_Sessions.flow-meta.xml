<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the value in booked slots to the NumSlotsTaken and the available slots to NumSlotsRemaining.</description>
        <name>Add_Slots</name>
        <label>Add Slots</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NumSlotsTaken</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Sessions.Booked_Slots__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NumSlotsRemaining</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Sessions.Available_Slots__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Sessions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigns the amount of money made or the amount of money still available to make.</description>
        <name>AmtMoney</name>
        <label>AmtMoney</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AmtMoneyMade</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FormMoneyMade</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AmtMoneytoMake</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FormMoneytoMake</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>This counts the number of booked people based on Experience Sessions. It also counts the remaining number of slots to be filled.</description>
    <environments>Default</environments>
    <formulas>
        <name>FormMoneyMade</name>
        <dataType>Currency</dataType>
        <expression>{!NumSlotsTaken} * {!Get_Experience_Records.Price__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormMoneytoMake</name>
        <dataType>Currency</dataType>
        <expression>{!NumSlotsRemaining} * {!Get_Experience_Records.Price__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Count Booked Experience Sessions {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Count Booked Experience Sessions</label>
    <loops>
        <description>This loops through each experience session and counts the booked slots and the remaining slots.</description>
        <name>Loop_Sessions</name>
        <label>Loop Sessions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Experience_Sessions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Slots</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>AmtMoney</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Experience_Records</name>
        <label>Get Experience Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Experience_Sessions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ExperienceName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Experience__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Experience_Sessions</name>
        <label>Get Experience Sessions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Sessions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Experience_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Experience_Records.Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>Range_Begin_Date</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>Range_End_Date</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Session__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Experience_Records</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>AmtMoneyMade</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>AmtMoneytoMake</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <description>This will be the experience name that is used to determine which experience is being targeted.</description>
        <name>ExperienceName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>This is the number of remaining slots.</description>
        <name>NumSlotsRemaining</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>NumSlotsTaken</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>The start of the date range used to determine which sessions to check. It is ok if the date range is a single day.</description>
        <name>Range_Begin_Date</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The end of the date range used to determine which sessions to check. It is ok if the date range is a single day.</description>
        <name>Range_End_Date</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
