<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the value in booked slots to the NumSlotsTaken and the Available Slots to NumSlotsRemaining.</description>
        <name>Add_Slots</name>
        <label>Add Slots</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>NumSlotsTaken</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Slots.Booked_Slots__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NumSlotsRemaining</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Slots.Available_Slots__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Slots</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigns the amount of money made or the amount of money still available to make.</description>
        <name>AmtMoney</name>
        <label>AmtMoney</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AmtMoneyMade</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FormMoneyMade</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AmtMoneytoMake</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FormMoneytoMake</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_1</name>
        <label>Decision 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_All_Experience_Records</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Experience_Name_Given</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ExperienceName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Experience_Records</targetReference>
            </connector>
            <label>Experience Name Given</label>
        </rules>
    </decisions>
    <description>This allows for the checking of one or all experiences to determine which has the greatest number of bookings or greatest spend.</description>
    <environments>Default</environments>
    <formulas>
        <name>FormMoneyMade</name>
        <dataType>Currency</dataType>
        <expression>{!NumSlotsTaken} * {!Get_Experience_Records.Price__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormMoneytoMake</name>
        <dataType>Currency</dataType>
        <expression>{!NumSlotsRemaining} * {!Get_Experience_Records.Price__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Check All Experience Sessions {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Check All Experience Sessions</label>
    <loops>
        <description>This loops through each experience session and counts the booked slots and the remaining slots.</description>
        <name>Loop_Slots</name>
        <label>Loop Slots</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Experience_Sessions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Slots</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>AmtMoney</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loops through all experiences.</description>
        <name>Loop_through_all_Experiences</name>
        <label>Loop through all Experiences</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Experience_Records</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Experience_Sessions_All</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Grabs all experience records.</description>
        <name>Get_All_Experience_Records</name>
        <label>Get All Experience Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_all_Experiences</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Experience__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Experience_Records</name>
        <label>Get Experience Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Experience_Sessions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ExperienceName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Experience__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Experience_Sessions</name>
        <label>Get Experience Sessions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Slots</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Experience_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Experience_Records.Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Booked_Slots__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Session__c</object>
        <sortField>Booked_Slots__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Loops through the Experience Sessions tied to each experience.</description>
        <name>Get_Experience_Sessions_All</name>
        <label>Get Experience Sessions_All</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_all_Experiences</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Experience_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Experience_Records.Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>Booked_Slots__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Session__c</object>
        <sortField>Booked_Slots__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_1</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>AmtMoneyMade</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>AmtMoneytoMake</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <description>This will be the experience name that is used to determine which experience is being targeted.</description>
        <name>ExperienceName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>This is the number of remaining slots.</description>
        <name>NumSlotsRemaining</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>NumSlotsTaken</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
